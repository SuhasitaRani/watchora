{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS, PUT, DELETE"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/ai/generate",
      "destination": "/api/ai/generate"
    },
    {
      "source": "/api/ai/intent",
      "destination": "/api/ai/intent"
    },
    {
      "source": "/api/tts/audio",
      "destination": "/api/tts/audio"
    },
    {
      "source": "/api/tts/voices",
      "destination": "/api/tts/voices"
    },
    {
      "source": "/api/translate",
      "destination": "/api/translate/translate"
    },
    {
      "source": "/api/stt/transcribe",
      "destination": "/api/stt/transcribe"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth/login"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth/me"
    },
    {
      "source": "/api/auth/signup",
      "destination": "/api/auth/signup"
    },
    {
      "source": "/api/auth/refresh",
      "destination": "/api/auth/refresh"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
